# Life Companion - environment configuration template.
# Copy to .env and fill in real values. Never commit .env.

# ---- Application ----
APP_ENV=development            # "development" | "production" | "test"
APP_VERSION=0.1.0
LOG_LEVEL=INFO
SECRET_KEY=replace-with-32-byte-random-secret-please

# ---- Database ----
# Local dev (docker-compose): postgresql+asyncpg://lc:lc@localhost:5432/life_companion
DATABASE_URL=postgresql+asyncpg://lc:lc@localhost:5432/life_companion
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DUCKDB_TEMP_DIR=D:/test 2/Life Companion/data/cache/duckdb_temp

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_TOKEN_TTL_SECONDS=900

# ---- Firebase ----
FIREBASE_PROJECT_ID=life-companion-dev
# Option A: leave empty to use Application Default Credentials (gcloud auth)
# Option B: absolute path to service account JSON file (MUST be on D:)
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---- LLM providers ----
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3.1-pro-preview
GEMINI_MODEL_FALLBACK=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_RETRIES=3
LLM_RETRY_WAIT_MIN_S=2.0
LLM_RETRY_WAIT_MAX_S=30.0

# ---- Encryption ----
# Phase 1 uses passthrough; Phase 4 wires this to KMS/Vault.
ENCRYPTION_KEY_STUB=stub-key-replace-in-phase4

# ---- Crisis detection ----
CRISIS_REGEX_ENABLED=true
CRISIS_LLM_ENABLED=false        # Phase 2 turns this on
CRISIS_LLM_CACHE_TTL_S=3600

# ---- Payments (Phase 5) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---- Observability ----
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
SENTRY_DSN=

# ---- Paths (all D:-safe per global rule) ----
LOG_DIR=D:/test 2/Life Companion/logs
DATA_DIR=D:/test 2/Life Companion/data

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---- Test infrastructure (only for pytest-postgresql on local dev) ----
POSTGRESQL_BIN=D:/PostgreSQL/16/bin
